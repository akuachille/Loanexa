@using MudBlazor
@using Application.DTO
@using Application.Interfaces

@using Domain.Entities

@inject IRequirement RequirementService
@inject IRequiredDocument RequiredDocumentService
@inject ILoanProductAdditionalRequirementService AdditionalReqService
@inject IUserContext UserContext
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudButton OnClick="GoBack" Variant="Variant.Text" Color="Color.Primary" Class="mr-4">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Class="mr-1"/> Back
            </MudButton>
            <MudIcon Icon="@Icons.Material.Filled.ListAlt" Class="mr-2" Color="Color.Primary" />
            <MudText Typo="Typo.h6">@ProductName - Requirements</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3" Variant="Variant.Filled">@ErrorMessage</MudAlert>
        }

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6">
            <MudTabPanel Text="Required Documents" Icon="@Icons.Material.Filled.Folder">
                <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                    <EditForm Model="@newDocument" OnValidSubmit="HandleSaveAndLinkDocument">
                        <DataAnnotationsValidator />
                        <MudGrid>
                            <MudItem xs="12" md="5">
                                <MudTextField Label="Document Name" @bind-Value="newDocument.DocumentName" 
                                              Variant="Variant.Outlined" Placeholder="e.g., National ID" Required="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField Label="Document Type" @bind-Value="newDocument.DocumentType" 
                                              Variant="Variant.Outlined" Placeholder="e.g., PDF/Image" Required="true" />
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-end">
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" 
                                           Color="Color.Primary" FullWidth="true" Style="height:56px" StartIcon="@Icons.Material.Filled.Add">
                                    Add Document
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </MudPaper>

                <MudTable Items="@_currentProductRequirements" Hover="true" Dense="true" Elevation="1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Linked Documents</MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Document Name</MudTh>
                        <MudTh>Type</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Name">@context.RequiredDocument?.DocumentName</MudTd>
                        <MudTd DataLabel="Type">@context.RequiredDocument?.DocumentType</MudTd>
                        <MudTd Style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>
            
            <MudTabPanel Text="Other Requirements" Icon="@Icons.Material.Filled.List">
                <MudPaper Elevation="0" Class="pa-4 mb-4" Style="background-color: var(--mud-palette-background-grey);">
                    <div class="d-flex align-center gap-2">
                        <MudTextField Label="Requirement Text" @bind-Value="newRequirementText" 
                                      Variant="Variant.Outlined" Placeholder="e.g., Age > 18" Required="true" Style="flex-grow:1;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Style="height:56px; margin-top: 4px;" StartIcon="@Icons.Material.Filled.Add" OnClick="AddTextRequirement">
                            Add Requirement
                        </MudButton>
                    </div>
                </MudPaper>

                <MudTable Items="@_additionalRequirements" Hover="true" Dense="true" Elevation="1">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Additional Requirements</MudText>
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Requirement Details</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Details">@context.RequirementText</MudTd>
                        <MudTd Style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteTextRequirement(context.Id))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Text">Finished</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    
    [Parameter] public int LoanProductId { get; set; }
    [Parameter] public string ProductName { get; set; } = "";

    private string ErrorMessage = "";
    private RequirementCreateDTO newRequirement = new();
    private RequiredDocumentCreateDTO newDocument = new();
    private string newRequirementText = "";

    private List<Requirement> _currentProductRequirements = new();
    private List<LoanProductAdditionalRequirement> _additionalRequirements = new();

    protected override async Task OnInitializedAsync()
    {
        newRequirement.LoanProductId = LoanProductId;
        await LoadData();
    }

    private async Task LoadData()
    {
        ErrorMessage = "";
        
        var allReqs = await RequirementService.GetAllRequirementsAsync();
        _currentProductRequirements = allReqs
            .Where(x => x.LoanProductId == LoanProductId)
            .ToList();
            
        _additionalRequirements = await AdditionalReqService.GetAdditionalRequirementsForProductAsync(LoanProductId);
    }

    private async Task HandleSaveAndLinkDocument()
    {
        try
        {
            int newDocId = await RequiredDocumentService.CreateRequiredDocumentAsync(newDocument);
            
            newRequirement.RequiredDocumentId = newDocId;
            await RequirementService.CreateRequirementAsync(newRequirement);

            Snackbar.Add("Document added and linked successfully", Severity.Success);
            
            await LoadData();
            StateHasChanged();
            
            newDocument = new RequiredDocumentCreateDTO();
            newRequirement = new RequirementCreateDTO { LoanProductId = LoanProductId };
        }
        catch (Exception ex) { ErrorMessage = "Error linking document: " + ex.Message; }
    }
    
    private async Task AddTextRequirement()
    {
        if (string.IsNullOrWhiteSpace(newRequirementText)) return;
        
        try
        {
            var req = new LoanProductAdditionalRequirement
            {
                LoanProductId = LoanProductId,
                RequirementText = newRequirementText,
                PersonId = UserContext.PersonId ?? 0
            };
            
            await AdditionalReqService.AddAdditionalRequirementAsync(req);
            Snackbar.Add("Requirement added successfully", Severity.Success);
            
            newRequirementText = "";
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex) { ErrorMessage = "Error adding requirement: " + ex.Message; }
    }

    private async Task DeleteTextRequirement(int id)
    {
        try
        {
            await AdditionalReqService.DeleteAdditionalRequirementAsync(id);
            Snackbar.Add("Requirement deleted", Severity.Success);
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex) { ErrorMessage = "Error deleting requirement: " + ex.Message; }
    }

    void Close() => MudDialog.Close();
    void GoBack() => MudDialog.Cancel();
}

