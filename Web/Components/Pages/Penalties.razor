@page "/Penality"
@using Domain.Entities
@using Application.Services.Penalities   
@using Application.Services.LoanApplications
@using MudBlazor
@inject IPenalityService PenalityService
@inject ILoanApplicationService LoanApplicationService
@inject IDialogService DialogService

<PageTitle>Penalty</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    @* --- DESIGN ADDITION: HEADER AREA --- *@
    @* <div class="d-flex align-center justify-space-between mb-6">
        <MudText Typo="Typo.h5" Style="font-weight: 800; color: #1B2559;">Penalty Management</MudText>
    </div> *@

    @* --- DESIGN ADDITION: ACTION BAR --- *@
    <MudGrid Class="mb-4" Spacing="2">
        <MudItem xs="12" Class="d-flex align-center justify-end gap-4">
            @if (_selectedItems.Any())
            {
                <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" Class="rounded-pill px-6" Style="text-transform:none; font-weight: 600;">
                    Delete Selected (@_selectedItems.Count)
                </MudButton>
            }
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Class="rounded-pill px-6" Style="background-color: #4318FF; color: white; text-transform:none; font-weight: 600;" OnClick="GoToCreatePenality">
                New Penalty
            </MudButton>
        </MudItem>
    </MudGrid>

    @* --- DESIGN ADDITION: DATAGRID --- *@
    <MudDataGrid T="Penality" 
                 Items="@_penalties" 
                 MultiSelection="true" 
                 @bind-SelectedItems="_selectedItems"
                 Hover="true" 
                 Elevation="0"
                 Class="mud-elevation-0 custom-datagrid border-solid border-2 mud-border-lines-default rounded-xl overflow-hidden">
                 
        <Columns>
            <SelectColumn T="Penality" />
            <PropertyColumn Property="x => x.Id" Title="ID" />
            
            <TemplateColumn Title="Applicant" Sortable="false">
                <CellTemplate>
                    <div class="d-flex align-center gap-3">
                        <MudAvatar Size="Size.Small" Style="background-color: #E2E8F0; color: #475569; font-weight: 700; font-size: 12px;">
                            @(context.Item.LoanApplication?.Borrower?.FirstName?.FirstOrDefault().ToString() ?? "A")
                        </MudAvatar>
                        <MudText Typo="Typo.body2" Style="font-weight: 600; color: #1B2559;">
                            @(!string.IsNullOrEmpty(context.Item.LoanApplication?.Borrower?.CompanyName) ? context.Item.LoanApplication.Borrower.CompanyName : $"{context.Item.LoanApplication?.Borrower?.FirstName} {context.Item.LoanApplication?.Borrower?.LastName}")
                        </MudText>
                    </div>
                </CellTemplate>
            </TemplateColumn>

            <PropertyColumn Property="x => x.Reason.Name" Title="Reason" />
            <PropertyColumn Property="x => x.Description" Title="Description" />
            
            <PropertyColumn Property="x => x.Amount" Title="Amount">
                <CellTemplate>
                    <MudText Typo="Typo.body2" Style="font-weight: 700; color: #ef4444;">
                        @context.Item.Amount.ToString("C")
                    </MudText>
                </CellTemplate>
            </PropertyColumn>

            <TemplateColumn Title="Status">
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small" 
                             Color="@(context.Item.IsActive ? Color.Error : Color.Success)" 
                             Style="font-weight: 600; font-size: 11px; padding: 0 10px;">
                        @(context.Item.IsActive ? "Active" : "Inactive")
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
        </Columns>

        <PagerContent>
            <MudDataGridPager T="Penality" />
        </PagerContent>
    </MudDataGrid>
</MudContainer>

@code{
    private List<Penality> _penalties = new();
    private HashSet<Penality> _selectedItems = new(); 
   
    private readonly DialogOptions _closeButton = new() { CloseButton = true };
    
    protected override async Task OnInitializedAsync()
    {
      await LoanApplicationService.UpdateWrittenOffLoansAsync();
      await PenalityService.GenerateAutomaticPenalitiesAsync();
      await LoadPenalties();
    }

    private async Task LoadPenalties()
    {
        _penalties = (await PenalityService.GetAllPenalitiesAsync()).OrderByDescending(x => x.Id).ToList();
        StateHasChanged();
    }

    private async Task GoToCreatePenality()
    {
        // Keeping logic consistent with your other pages
        DialogOptions options = new DialogOptions() { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<CreatePenality>("Add Penalty", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await Task.Delay(50);
            await LoadPenalties();
        }
    }
}
