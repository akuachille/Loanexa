<MudDialog Style="overflow:hidden; max-width: 500px; width: 100%;">
    <DialogContent>
        <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight: 600;">Password Reset Successful</MudText>
        <MudText Typo="Typo.body1" Style="font-size: 1.2rem; line-height: 1.6;" Class="mb-6">
            The password for <strong>@Email</strong> has been reset successfully. Please securely share this temporary password with them:
        </MudText>
        
        <MudTextField T="string" Value="@TemporaryPassword" 
                      ReadOnly="true" 
                      Variant="Variant.Outlined" 
                      Margin="Margin.None"
                      Class="mb-4 custom-large-input"
                      Style="font-size: 2rem; font-weight: 900; text-align: center; letter-spacing: 2px; color: #4318FF;" />
        
        <MudText Typo="Typo.body1" Color="Color.Error" Style="font-size: 1.1rem; font-weight: 500;">
            It is valid for 15 minutes.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Variant="Variant.Filled" Color="Color.Primary" Style="font-size: 1.1rem; padding: 8px 24px;">OK</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .custom-large-input input {
        font-size: 2rem !important;
        font-weight: 900 !important;
        text-align: center !important;
        letter-spacing: 2px !important;
        color: #4318FF !important;
        padding: 16px !important;
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
    
    [Parameter] public string Email { get; set; }
    [Parameter] public string TemporaryPassword { get; set; }
    
    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }
}
