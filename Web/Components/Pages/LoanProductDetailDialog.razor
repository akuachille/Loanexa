@using Application.Interfaces
@using Domain.Entities
@using MudBlazor
@inject IRequirementService RequirementService
@inject ILoanProductAdditionalRequirementService AdditionalReqService
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-3 mb-n1" />
            Loan Product Details
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="max-height: 600px; overflow-y: auto" Class="pa-0">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Product Name</MudText>
                    <MudText Typo="Typo.body1" Style="font-weight: 700;">@Product.ProductName</MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Product ID</MudText>
                    <MudText Typo="Typo.body1"># @Product.Id</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Description</MudText>
                    <MudText Typo="Typo.body2" Class="mb-4">
                        @(string.IsNullOrEmpty(Product.Description) ? "No description provided." : Product.Description)
                    </MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudCard Elevation="0" Style="background-color: var(--mud-palette-background-grey); border-radius: 12px;">
                        <MudCardHeader Class="pb-2">
                            <CardHeaderContent>
                                <div class="d-flex justify-space-between align-center">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 800;">REQUIRED DOCUMENTS & REQUIREMENTS</MudText>
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenRequirementDialog">Add Requirements</MudButton>
                                </div>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudList T="string" Clickable="true" Dense="true">
                            @if (Requirements.Count == 0 && AdditionalRequirements.Count == 0)
                            {
                                <MudListItem>
                                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="px-4 pb-2">No requirements linked.</MudText>
                                </MudListItem>
                            }
                            else
                            {
                                @foreach (var req in Requirements)
                                {
                                    <MudListItem>
                                        <MudButton Variant="Variant.Text" 
                                                Color="Color.Primary" 
                                                StartIcon="@Icons.Material.Filled.Folder"
                                                OnClick="@(() => HandleDocumentClick(req.RequiredDocument?.DocumentName))"
                                                Style="text-transform:none; justify-content: flex-start;"
                                                FullWidth="true">
                                            @(req.RequiredDocument?.DocumentName ?? "Unnamed Document") 
                                            <span class="ml-2 mud-text-secondary">(@req.RequiredDocument?.DocumentType)</span>
                                        </MudButton>
                                    </MudListItem>
                                }
                                @foreach (var req in AdditionalRequirements)
                                {
                                    <MudListItem>
                                        <MudButton Variant="Variant.Text" 
                                                Color="Color.Primary" 
                                                StartIcon="@Icons.Material.Filled.List"
                                                Style="text-transform:none; justify-content: flex-start;"
                                                FullWidth="true">
                                            @req.RequirementText
                                        </MudButton>
                                    </MudListItem>
                                }
                            }
                        </MudList>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close" Class="px-8">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public int Id { get; set; }
    [Parameter] public LoanProduct Product { get; set; } = new();
    [Parameter] public List<Requirement> Requirements { get; set; } = new();
    private List<LoanProductAdditionalRequirement> AdditionalRequirements { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRequirements();
    }

    private async Task LoadRequirements()
    {
        var allRequirements = await RequirementService.GetAllRequirementsAsync();
        Requirements = allRequirements.Where(r => r.LoanProductId == Product.Id).ToList();

        AdditionalRequirements = await AdditionalReqService.GetAdditionalRequirementsForProductAsync(Product.Id);
    }

    private void HandleDocumentClick(string? documentName)
    {
        if (!string.IsNullOrEmpty(documentName))
        {
            Console.WriteLine($"Selected document: {documentName}");
        }
    }

    private async Task OpenRequirementDialog()
    {
        var parameters = new DialogParameters 
        { 
            { "LoanProductId", Product.Id },
            { "ProductName", Product.ProductName }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<LoanProductRequirementDialog>("Add Requirements", parameters, options);
        var result = await dialog.Result;
        
        await LoadRequirements();
        StateHasChanged();
    }

    private void Close() => MudDialog.Close();
}
